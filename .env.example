# Copy this file to `.env.local` and fill in the values. Never commit .env.local.
# On Vercel, add the same three under Project → Settings → Environment Variables.

# Paystack dashboard → Settings → API Keys & Webhooks.
# Use your Paystack TEST secret key while testing, then switch to the LIVE one.
PAYSTACK_SECRET_KEY=paste-your-paystack-secret-key-here

# Your WhatsApp group invite link. Only the server ever sees this.
WHATSAPP_GROUP_LINK=paste-your-whatsapp-group-invite-link-here

# The site's public address, where Paystack sends people back after paying.
# Leave empty to use whatever address the site was opened on.
SITE_URL=
